<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">

            <!-- Outer Pulse Ring -->
            <group
                android:name="pulse_ring"
                android:pivotX="54"
                android:pivotY="54">
                <path
                    android:fillColor="#00000000"
                    android:pathData="M54,54m-34,0a34,34 0,1 1,68 0a34,34 0,1 1,-68 0"
                    android:strokeAlpha="0.35"
                    android:strokeColor="#FFC107"
                    android:strokeWidth="1.8" />
            </group>

            <!-- Coral Red Circular Badge (fits inside Android 12+ 72dp safe zone) -->
            <group
                android:name="badge_group"
                android:pivotX="54"
                android:pivotY="54">
                <path
                    android:fillColor="@color/ic_launcher_background"
                    android:pathData="M54,54m-32,0a32,32 0,1 1,64 0a32,32 0,1 1,-64 0" />

                <!-- Animated Padlock Shackle -->
                <group
                    android:name="shackle_group"
                    android:pivotX="54"
                    android:pivotY="47.33"
                    android:translateY="-5">
                    <path
                        android:fillColor="#FFC107"
                        android:pathData="M63.52,47.33L63.52,43.52C63.52,38.27 59.26,34 54,34C48.74,34 44.48,38.27 44.48,43.52L44.48,47.33L48.1,47.33L48.1,43.52C48.1,40.27 50.74,37.62 54,37.62C57.26,37.62 59.9,40.27 59.9,43.52L59.9,47.33Z" />
                </group>

                <!-- Padlock Body -->
                <path
                    android:fillColor="#FFC107"
                    android:pathData="M42.57,47.33L65.43,47.33C67.52,47.33 69.24,49.05 69.24,51.14L69.24,70.19C69.24,72.29 67.52,74 65.43,74L42.57,74C40.48,74 38.76,72.29 38.76,70.19L38.76,51.14C38.76,49.05 40.48,47.33 42.57,47.33Z" />

                <!-- Animated Keyhole -->
                <group
                    android:name="keyhole_group"
                    android:pivotX="54"
                    android:pivotY="60.67">
                    <path
                        android:fillColor="@color/ic_launcher_background"
                        android:pathData="M54,60.67m-3.81,0a3.81,3.81 0,1 1,7.62 0a3.81,3.81 0,1 1,-7.62 0" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <!-- Badge entrance scale -->
    <target android:name="badge_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="450"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:valueFrom="0.75"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="450"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:valueFrom="0.75"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <!-- Shackle lock-in drop -->
    <target android:name="shackle_group">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="400"
                android:interpolator="@android:interpolator/overshoot"
                android:propertyName="translateY"
                android:startOffset="220"
                android:valueFrom="-5"
                android:valueTo="0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <!-- Keyhole lock confirmation pulse -->
    <target android:name="keyhole_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="320"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:startOffset="320"
                    android:valueFrom="0.6"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="320"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:startOffset="320"
                    android:valueFrom="0.6"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <!-- Outer ring ripple -->
    <target android:name="pulse_ring">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="650"
                    android:interpolator="@android:interpolator/decelerate_cubic"
                    android:propertyName="scaleX"
                    android:startOffset="150"
                    android:valueFrom="0.85"
                    android:valueTo="1.05"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="650"
                    android:interpolator="@android:interpolator/decelerate_cubic"
                    android:propertyName="scaleY"
                    android:startOffset="150"
                    android:valueFrom="0.85"
                    android:valueTo="1.05"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

</animated-vector>
