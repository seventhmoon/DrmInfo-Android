<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".MobileActivity">

    <data>

        <import type="android.view.View" />

        <import type="android.os.Build" />

        <variable
            name="infoProperties"
            type="androidx.databinding.ObservableMap&lt;String, Object&gt;" />

        <variable
            name="clearkeyProperties"
            type="androidx.databinding.ObservableMap&lt;String, Object&gt;" />

        <variable
            name="widevineProperties"
            type="androidx.databinding.ObservableMap&lt;String, Object&gt;" />

        <variable
            name="playreadyProperties"
            type="androidx.databinding.ObservableMap&lt;String, Object&gt;" />

        <variable
            name="wiseplayProperties"
            type="androidx.databinding.ObservableMap&lt;String, Object&gt;" />

        <variable
            name="handler"
            type="com.androidfung.drminfo.ui.mobile.MyHandlers" />

    </data>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/view_nestedscrollview"
        android:name="com.androidfung.drminfo.MobileActivityFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:ignore="PrivateResource">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/activity_horizontal_margin"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:layout_marginEnd="@dimen/activity_horizontal_margin"
            android:layout_marginBottom="@dimen/activity_vertical_margin"
            android:animateLayoutChanges="true"
            android:descendantFocusability="blocksDescendants"
            android:paddingBottom="16dp">

            <include
                android:id="@+id/container_info"
                layout="@layout/fragment_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/container_ad"
                app:layout_constraintTop_toTopOf="parent"
                bind:handler="@{handler}"
                bind:infoProperties="@{infoProperties}" />

            <include
                android:id="@+id/container_clearkey"
                layout="@layout/fragment_mediadrm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/container_ad"
                app:layout_constraintTop_toBottomOf="@id/container_info"
                bind:handler="@{handler}"
                bind:properties="@{clearkeyProperties}" />

            <include
                android:id="@+id/container_widevine"
                layout="@layout/fragment_widevine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/container_ad"
                app:layout_constraintTop_toBottomOf="@id/container_clearkey"
                bind:handler="@{handler}"
                bind:properties="@{widevineProperties}" />

            <include
                android:id="@+id/container_playready"
                layout="@layout/fragment_mediadrm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/container_ad"
                app:layout_constraintTop_toBottomOf="@id/container_widevine"
                bind:handler="@{handler}"
                bind:properties="@{playreadyProperties}" />

            <include
                android:id="@+id/container_wiseplay"
                layout="@layout/fragment_mediadrm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/container_ad"
                app:layout_constraintTop_toBottomOf="@id/container_playready"
                bind:handler="@{handler}"
                bind:properties="@{wiseplayProperties}" />

            <include
                android:id="@+id/container_ad"
                layout="@layout/fragment_ad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintLeft_toRightOf="@id/container_info"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</layout>