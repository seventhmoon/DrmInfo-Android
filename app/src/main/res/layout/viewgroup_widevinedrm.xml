<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <import type="android.text.TextUtils" />

        <import type="com.androidfung.drminfo.Util" />

        <variable
            name="properties"
            type="androidx.databinding.ObservableMap&lt;String, Object&gt;" />

        <variable
            name="handler"
            type="com.androidfung.drminfo.ui.mobile.MyHandlers" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_label_systemid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/listitem_padding"
            android:singleLine="true"
            android:text="@string/widevine_string_property_name_systemId"
            android:textAppearance="?attr/textAppearanceCaption"
            android:visibility="@{TextUtils.isEmpty((String) properties[(@string/widevine_string_property_key_systemId)]) ? View.GONE : View.VISIBLE}" />

        <TextView
            android:id="@+id/tv_value_systemid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text='@{properties[(@string/widevine_string_property_key_systemId)] ?? "-"}'
            android:textAlignment="viewEnd"
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility="@{TextUtils.isEmpty((String) properties[(@string/widevine_string_property_key_systemId)]) ? View.GONE : View.VISIBLE}"
            tools:text="{SYSTEM_ID}" />

        <TextView
            android:id="@+id/tv_label_securitylevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/listitem_padding"
            android:singleLine="true"
            android:text="@string/widevine_string_property_name_securityLevel"
            android:textAppearance="?attr/textAppearanceCaption"
            android:visibility="@{TextUtils.isEmpty((String) properties[(@string/widevine_string_property_key_securityLevel)]) ? View.GONE : View.VISIBLE}"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_label_systemid" />

        <TextView
            android:id="@+id/tv_value_securitylevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text='@{properties[(@string/widevine_string_property_key_securityLevel)] ?? "-"}'
            android:textAlignment="viewEnd"
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility="@{TextUtils.isEmpty((String) properties[(@string/widevine_string_property_key_securityLevel)]) ? View.GONE : View.VISIBLE}"
            tools:text="{SECURITY_LEVEL}" />

        <TextView
            android:id="@+id/tv_label_maxnumberofsessions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/listitem_padding"
            android:singleLine="true"
            android:text="@string/widevine_string_property_name_maxNumberOfSessions"
            android:textAppearance="?attr/textAppearanceCaption"
            android:visibility="@{TextUtils.isEmpty((String) properties[(@string/widevine_string_property_key_maxNumberOfSessions)]) ? View.GONE : View.VISIBLE}" />

        <TextView
            android:id="@+id/tv_value_maxnumberofsession"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text='@{properties[(@string/widevine_string_property_key_maxNumberOfSessions)] ?? "-"}'
            android:textAlignment="viewEnd"
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility="@{TextUtils.isEmpty((String) properties[(@string/widevine_string_property_key_maxNumberOfSessions)]) ? View.GONE : View.VISIBLE}"
            tools:text="{MAX_NUMBER_OF_SESSION}" />

        <TextView
            android:id="@+id/tv_label_oemcryptoversion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/listitem_padding"
            android:singleLine="true"
            android:text="@string/widevine_string_property_name_oemCryptoApiVersion"
            android:textAppearance="?attr/textAppearanceCaption"
            android:visibility="@{TextUtils.isEmpty((String) properties[(@string/widevine_string_property_key_oemCryptoApiVersion)]) ? View.GONE : View.VISIBLE}" />

        <TextView
            android:id="@+id/tv_value_oemcryptoversion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text='@{properties[(@string/widevine_string_property_key_oemCryptoApiVersion)] ?? "-"}'
            android:textAlignment="viewEnd"
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility="@{TextUtils.isEmpty((String) properties[(@string/widevine_string_property_key_oemCryptoApiVersion)]) ? View.GONE : View.VISIBLE}"
            tools:text="{OEM_CRYPTO_VERSION}" />
    </LinearLayout>
    <!--    </androidx.constraintlayout.widget.ConstraintLayout>-->
</layout>