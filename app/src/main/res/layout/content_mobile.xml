<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".MobileActivity">

    <data>
        <import type="android.view.View" />
        <import type="android.os.Build" />

        <variable
            name="infoProperties"
            type="androidx.databinding.ObservableMap&lt;String, Object&gt;" />

        <variable
            name="clearkeyProperties"
            type="androidx.databinding.ObservableMap&lt;String, Object&gt;" />

        <variable
            name="widevineProperties"
            type="androidx.databinding.ObservableMap&lt;String, Object&gt;" />

        <variable
            name="playreadyProperties"
            type="androidx.databinding.ObservableMap&lt;String, Object&gt;" />

        <variable
            name="wiseplayProperties"
            type="androidx.databinding.ObservableMap&lt;String, Object&gt;" />

        <variable name="handler" type="com.androidfung.drminfo.ui.mobile.MyHandlers"/>

    </data>

    <androidx.core.widget.NestedScrollView
        android:name="com.androidfung.drminfo.MobileActivityFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:ignore="PrivateResource">

        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/activity_horizontal_margin"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:layout_marginEnd="@dimen/activity_horizontal_margin"
            android:layout_marginBottom="@dimen/activity_vertical_margin"
            android:descendantFocusability="blocksDescendants"
            app:alignItems="stretch"
            app:flexWrap="wrap"
            app:justifyContent="center">

            <include
                layout="@layout/fragment_info"
                bind:infoProperties="@{infoProperties}"
                bind:handler="@{handler}"/>

            <include
                layout="@layout/fragment_mediadrm"
                bind:properties="@{clearkeyProperties}"
                bind:handler="@{handler}" />

            <include
                layout="@layout/fragment_widevine"
                bind:properties="@{widevineProperties}"
                bind:handler="@{handler}" />

            <include
                layout="@layout/fragment_mediadrm"
                bind:handler="@{handler}"
                bind:properties="@{playreadyProperties}" />

            <include
                layout="@layout/fragment_mediadrm"
                bind:handler="@{handler}"
                bind:properties="@{wiseplayProperties}" />

            <include
                layout="@layout/fragment_ad" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

        </com.google.android.flexbox.FlexboxLayout>
    </androidx.core.widget.NestedScrollView>
</layout>