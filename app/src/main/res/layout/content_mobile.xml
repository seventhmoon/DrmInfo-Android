<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:name="com.androidfung.drminfo.MobileActivityFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">


    <com.google.android.flexbox.FlexboxLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/activity_vertical_margin"
        android:layout_marginEnd="@dimen/activity_horizontal_margin"
        android:layout_marginStart="@dimen/activity_horizontal_margin"
        android:layout_marginTop="@dimen/activity_vertical_margin"
        android:descendantFocusability="blocksDescendants"
        app:alignContent="stretch"
        app:alignItems="stretch"
        app:flexWrap="wrap"
        app:justifyContent="center">




        <fragment
            android:id="@+id/fragment_info"
            android:name="com.androidfung.drminfo.InfoFragment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_minWidth="@dimen/box_min_width"
            android:layout_margin="4dp"
            app:layout_flexGrow="@integer/layout_flexGrow"

            tools:layout="@layout/fragment_info" />

        <fragment
            app:layout_minWidth="@dimen/box_min_width"
            android:id="@+id/fragment_clearkey"
            android:name="com.androidfung.drminfo.ClearKeyFragment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            app:layout_flexGrow="@integer/layout_flexGrow"
            tools:layout="@layout/fragment_clearkey" />

        <fragment
            app:layout_minWidth="@dimen/box_min_width"
            android:id="@+id/fragment_widevine"
            android:name="com.androidfung.drminfo.WidevineFragment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            app:layout_flexGrow="@integer/layout_flexGrow"
            tools:layout="@layout/fragment_widevine" />

        <fragment
            app:layout_minWidth="@dimen/box_min_width"
            android:id="@+id/fragment_playready"
            android:name="com.androidfung.drminfo.PlayreadyFragment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            app:layout_flexGrow="@integer/layout_flexGrow"
            tools:layout="@layout/fragment_playready" />

        <fragment
            app:layout_minWidth="@dimen/box_min_width"
            android:id="@+id/fragment_primetime"
            android:name="com.androidfung.drminfo.PrimetimeFragment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            app:layout_flexGrow="@integer/layout_flexGrow"
            tools:layout="@layout/fragment_primetime" />

        <fragment
            app:layout_minWidth="@dimen/box_min_width"
            android:id="@+id/fragment_marlin"
            android:name="com.androidfung.drminfo.MarlinFragment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            app:layout_flexGrow="@integer/layout_flexGrow"
            tools:layout="@layout/fragment_marlin" />

        <fragment
            app:layout_minWidth="@dimen/box_min_width"
            android:id="@+id/fragment_verimatrix"
            android:name="com.androidfung.drminfo.VerimatrixFragment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            app:layout_flexGrow="@integer/layout_flexGrow"
            tools:layout="@layout/fragment_verimatrix" />

        <fragment
            app:layout_minWidth="@dimen/box_min_width"
            android:id="@+id/fragment_ad"
            android:name="com.androidfung.drminfo.AdFragment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            app:layout_flexGrow="@integer/layout_flexGrow"
            tools:layout="@layout/fragment_ad" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

    </com.google.android.flexbox.FlexboxLayout>

</android.support.v4.widget.NestedScrollView>