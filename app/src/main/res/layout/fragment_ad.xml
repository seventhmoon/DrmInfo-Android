<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <android.support.v7.widget.CardView
        android:id="@+id/container_banner_ad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/box_min_height"
        android:minWidth="@dimen/box_min_width"
        app:contentPadding="8dp"
        app:layout_gravity="center_horizontal"
        app:cardUseCompatPadding="true"
        android:visibility="gone">
        <com.google.android.gms.ads.AdView
            android:layout_gravity="center_horizontal"
            android:id="@+id/adView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            app:adSize="MEDIUM_RECTANGLE"
            app:adUnitId="@string/ad_unit_id_medium_rect"/>
    </android.support.v7.widget.CardView>

    <android.support.v7.widget.CardView
        android:id="@+id/container_native_ad"
        android:minHeight="@dimen/box_min_height"
        android:minWidth="@dimen/box_min_width"
        android:layout_width="match_parent"
        android:layout_height="@dimen/native_ad_min_height"
        app:cardUseCompatPadding="true"
        app:layout_gravity="center_horizontal"
        android:visibility="gone"/>
</RelativeLayout>


