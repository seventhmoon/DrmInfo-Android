<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <import type="android.view.View" />

        <import type="com.google.common.base.Strings" />

        <variable
            name="properties"
            type="androidx.databinding.ObservableMap&lt;String, Object&gt;" />

    </data>

    <merge>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:text='@{@string/mediadrm_string_property_name_vendor}'
            android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
            android:visibility="@{properties[(@string/mediadrm_string_property_key_vendor)] != null ? View.VISIBLE : View.GONE}" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text='@{properties[(@string/mediadrm_string_property_key_vendor)] ?? "-"}'
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:visibility="@{properties[(@string/mediadrm_string_property_key_vendor)] != null ? View.VISIBLE : View.GONE}" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:text='@{@string/mediadrm_string_property_name_version}'
            android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
            android:visibility="@{properties[(@string/mediadrm_string_property_key_version)] != null ? View.VISIBLE : View.GONE}" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text='@{properties[(@string/mediadrm_string_property_key_version)] ?? "-"}'
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:visibility="@{properties[(@string/mediadrm_string_property_key_version)] != null ? View.VISIBLE : View.GONE}" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:text='@{@string/mediadrm_string_property_name_algorithms}'
            android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
            android:visibility="@{Strings.isNullOrEmpty((String) properties[(@string/mediadrm_string_property_key_algorithms)]) ? View.GONE : View.VISIBLE}" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text='@{properties[(@string/mediadrm_string_property_key_algorithms)] ?? "-"}'
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:visibility="@{Strings.isNullOrEmpty((String) properties[(@string/mediadrm_string_property_key_algorithms)]) ? View.GONE : View.VISIBLE}" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:text='@{@string/mediadrm_bytearray_property_name_deviceuniqueid}'
            android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
            android:visibility="@{Strings.isNullOrEmpty((String) properties[(@string/mediadrm_bytearray_property_key_deviceuniqueid)]) ? View.GONE : View.VISIBLE}" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text='@{properties[(@string/mediadrm_bytearray_property_key_deviceuniqueid)] ?? "-"}'
            android:singleLine="true"
            android:ellipsize="middle"
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:visibility="@{Strings.isNullOrEmpty((String) properties[(@string/mediadrm_bytearray_property_key_deviceuniqueid)]) ? View.GONE : View.VISIBLE}" />

    </merge>
</layout>