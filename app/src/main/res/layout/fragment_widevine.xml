<!--suppress AndroidDomInspection -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="properties"
            type="androidx.databinding.ObservableMap&lt;String, Object&gt;" />
        <variable name="handler" type="com.androidfung.drminfo.ui.mobile.MyHandlers"/>

    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/card_horizontal_margin"
        android:layout_marginTop="@dimen/card_vertical_margin"
        android:layout_marginEnd="@dimen/card_horizontal_margin"
        android:layout_marginBottom="@dimen/card_vertical_margin"
        android:minWidth="@dimen/box_min_width"
        android:minHeight="@dimen/box_min_height"
        android:visibility="@{properties.isEmpty() ? View.GONE : View.VISIBLE}"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardUseCompatPadding="true"
        app:contentPadding="@dimen/card_padding"
        app:layout_flexGrow="1"
        tools:context=".MobileActivity">


        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="@font/open_sans"
                android:singleLine="true"
                android:text="@{properties[(@string/mediadrm_string_property_key_description)]}"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
                tools:text="Media DRM" />

            <include
                layout="@layout/viewgroup_mediadrm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                bind:properties="@{properties}"
                bind:handler="@{handler}"/>

            <include
                layout="@layout/viewgroup_widevinedrm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                bind:properties="@{properties}"
                bind:handler="@{handler}"/>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </com.google.android.material.card.MaterialCardView>
</layout>