<!--suppress AndroidDomInspection -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="properties"
            type="androidx.databinding.ObservableMap&lt;String, Object&gt;" />

        <variable
            name="mediaDrm"
            type="android.media.MediaDrm" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/card_horizontal_margin"
        android:layout_marginTop="@dimen/card_vertical_margin"
        android:layout_marginEnd="@dimen/card_horizontal_margin"
        android:layout_marginBottom="@dimen/card_vertical_margin"
        android:minWidth="@dimen/box_min_width"
        android:minHeight="@dimen/box_min_height"
        app:contentPadding="16dp"
        tools:context=".ui.mobile.WidevineFragment">


        <LinearLayout
            android:id="@+id/gridlayout_widevine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="@string/text_widevine_name"
                android:textAppearance="@style/TextAppearance.AppCompat.Headline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/text_widevine_name"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="@{properties.isEmpty() ? @string/text_not_supported : @string/text_supported}"
                android:textAppearance="@style/TextAppearance.AppCompat.Body2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/text_media_drm_description"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                android:visibility="@{properties[@string/key_media_drm_description] != null ? View.VISIBLE : View.GONE}" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text='@{properties[@string/key_media_drm_description]?? "-"}'
                android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                android:visibility="@{properties[@string/key_media_drm_description] != null ? View.VISIBLE : View.GONE}" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:text="@string/text_media_drm_version"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                android:visibility="@{properties[@string/key_media_drm_version] != null ? View.VISIBLE : View.GONE}" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text='@{properties[@string/key_media_drm_version]?? "-"}'
                android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                android:visibility="@{properties[@string/key_media_drm_version] != null ? View.VISIBLE : View.GONE}" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/text_widevine_system_id"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                android:visibility="@{properties[@string/key_widevine_system_id] != null ? View.VISIBLE : View.GONE}" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text='@{properties[@string/key_widevine_system_id]?? "-"}'
                android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                android:visibility="@{properties[@string/key_widevine_system_id] != null ? View.VISIBLE : View.GONE}" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/text_widevine_security_level"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                android:visibility="@{properties[@string/key_widevine_security_level] != null ? View.VISIBLE : View.GONE}" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text='@{properties[@string/key_widevine_security_level]?? "-"}'
                android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                android:visibility="@{properties[@string/key_widevine_security_level] != null ? View.VISIBLE : View.GONE}" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/text_widevine_hdcp_level"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                android:visibility="@{properties[@string/key_widevine_hdcp_level] != null ? View.VISIBLE : View.GONE}" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text='@{properties[@string/key_widevine_hdcp_level]?? "-"}'
                android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                android:visibility="@{properties[@string/key_widevine_hdcp_level] != null ? View.VISIBLE : View.GONE}" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/text_widevine_max_hdcp_level"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                android:visibility="@{properties[@string/key_widevine_max_hdcp_level] != null ? View.VISIBLE : View.GONE}" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text='@{properties[@string/key_widevine_max_hdcp_level] ?? "-"}'
                android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                android:visibility="@{properties[@string/key_widevine_max_hdcp_level] != null ? View.VISIBLE : View.GONE}" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/text_widevine_number_of_open_sessions"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                android:visibility="@{properties[@string/key_widevine_number_of_open_sessions] != null ? View.VISIBLE : View.GONE}" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text='@{properties[@string/key_widevine_number_of_open_sessions] ?? "-"}'
                android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                android:visibility="@{properties[@string/key_widevine_number_of_open_sessions] != null ? View.VISIBLE : View.GONE}" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/text_widevine_max_number_of_sessions"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                android:visibility="@{properties[@string/key_widevine_max_number_of_sessions] != null ? View.VISIBLE : View.GONE}" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text='@{properties[@string/key_widevine_max_number_of_sessions] ?? "-"}'
                android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                android:visibility="@{properties[@string/key_widevine_max_number_of_sessions] != null ? View.VISIBLE : View.GONE}" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/text_widevine_usage_reporting_support"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                android:visibility="@{properties[@string/key_widevine_usage_reporting_support] != null ? View.VISIBLE : View.GONE}" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text='@{properties[@string/key_widevine_usage_reporting_support] ?? "-"}'
                android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                android:visibility="@{properties[@string/key_widevine_usage_reporting_support] != null ? View.VISIBLE : View.GONE}" />


        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>
</layout>