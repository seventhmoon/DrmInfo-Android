<!--suppress AndroidDomInspection -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="properties"
            type="androidx.databinding.ObservableMap&lt;String, Object&gt;" />

    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/card_vertical_margin"
        android:layout_marginEnd="@dimen/card_horizontal_margin"
        android:layout_marginStart="@dimen/card_horizontal_margin"
        android:layout_marginTop="@dimen/card_vertical_margin"
        android:minHeight="@dimen/box_min_height"
        android:minWidth="@dimen/box_min_width"
        app:contentPadding="16dp"
        android:visibility="@{properties.isEmpty() ? View.GONE : View.VISIBLE}"
        tools:context="com.androidfung.drminfo.ui.mobile.VerimatrixFragment">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{properties[(@stringArray/mediadrm_string_property_keys[1])]}"
                android:textAppearance="@style/TextAppearance.AppCompat.Headline" />

            <include layout="@layout/merge_mediadrm" bind:properties="@{properties}"/>

        </LinearLayout>


    </com.google.android.material.card.MaterialCardView>
</layout>