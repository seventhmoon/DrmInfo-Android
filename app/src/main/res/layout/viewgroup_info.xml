<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <import type="android.content.res.Configuration" />

        <import type="android.os.Build" />

        <variable
            name="handler"
            type="com.androidfung.drminfo.ui.mobile.MyHandlers" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_label_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/text_brand"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_value_brand"
            app:layout_constraintEnd_toStartOf="@+id/tv_value_brand"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_value_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@{Build.BRAND}"
            android:textAlignment="viewEnd"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_label_brand"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Google" />

        <TextView
            android:id="@+id/tv_label_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/text_model"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            android:visibility="gone"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_value_model"
            app:layout_constraintEnd_toStartOf="@+id/tv_value_model"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_label_brand" />

        <TextView
            android:id="@+id/tv_value_model"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@{Build.MODEL}"
            android:textAlignment="viewEnd"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            android:visibility="gone"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_label_model"
            app:layout_constraintTop_toBottomOf="@+id/tv_value_brand"
            tools:text="Pixel" />


        <TextView
            android:id="@+id/tv_label_product"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/text_hardware"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_value_product"
            app:layout_constraintEnd_toStartOf="@+id/tv_value_product"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_label_model" />

        <TextView
            android:id="@+id/tv_value_product"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:text="@{Build.HARDWARE}"
            android:textAlignment="viewEnd"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_label_product"
            app:layout_constraintTop_toBottomOf="@+id/tv_value_model"
            tools:text="sailfish" />

        <TextView
            android:id="@+id/tv_label_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/text_type"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_value_type"
            app:layout_constraintEnd_toStartOf="@+id/tv_value_type"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_label_product" />

        <TextView
            android:id="@+id/tv_value_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@{Build.TYPE}"
            android:textAlignment="viewEnd"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_label_type"
            app:layout_constraintTop_toBottomOf="@+id/tv_value_product"
            tools:text="user" />

        <TextView
            android:id="@+id/tv_label_display"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/text_display"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_value_display"
            app:layout_constraintEnd_toStartOf="@+id/tv_value_display"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_label_type" />

        <TextView
            android:id="@+id/tv_value_display"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:onLongClick="@{handler::onLongClick}"
            android:text="@{Build.DISPLAY}"
            android:textAlignment="viewEnd"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_label_display"
            app:layout_constraintTop_toBottomOf="@+id/tv_value_type"
            tools:text="PPR1" />

        <TextView
            android:id="@+id/tv_label_fingerprint"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/text_fingerprint"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_value_fingerprint"
            app:layout_constraintEnd_toStartOf="@+id/tv_value_fingerprint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_label_display" />

        <TextView
            android:id="@+id/tv_value_fingerprint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:onLongClick="@{handler::onLongClick}"

            android:text="@{Build.FINGERPRINT}"
            android:textAlignment="viewEnd"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_label_fingerprint"
            app:layout_constraintTop_toBottomOf="@+id/tv_value_display"
            tools:text="PPR1.PEAEGJAOE/egoeogah ea/gega /egvadvasvpoaj jpoavjpodj ajdvavfaogeoaehfoah egae:bv segaegeag egaegaega" />


        <TextView
            android:id="@+id/tv_label_sdklevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/text_sdk_level"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toStartOf="@+id/tv_value_sdklevel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_label_fingerprint" />

        <TextView
            android:id="@+id/tv_value_sdklevel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="@{String.valueOf(Build.VERSION.SDK_INT)}"
            android:textAlignment="viewEnd"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_label_sdklevel"
            app:layout_constraintTop_toBottomOf="@+id/tv_value_fingerprint"
            tools:text="1" />


        <TextView
            android:id="@+id/tv_label_abis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/text_abi"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            android:visibility="@{Build.VERSION.SDK_INT >= 21?View.VISIBLE:View.GONE}"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toStartOf="@+id/tv_value_abis"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_label_sdklevel" />

        <TextView
            android:id="@+id/tv_value_abis"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:text='@{(Build.VERSION.SDK_INT &lt; 21)?"-":java.util.Arrays.toString(Build.SUPPORTED_ABIS).replace("[","").replace("]","")}'
            android:onLongClick="@{handler::onLongClick}"
            android:visibility="@{Build.VERSION.SDK_INT >= 21?View.VISIBLE:View.GONE}"
            android:textAlignment="viewEnd"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_label_abis"
            app:layout_constraintTop_toBottomOf="@+id/tv_value_sdklevel"
            tools:text="1" />


        <TextView
            android:id="@+id/tv_label_widecg"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/text_wide_color"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            android:visibility="@{Build.VERSION.SDK_INT >= 26?View.VISIBLE:View.GONE}"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_value_widecg"
            app:layout_constraintEnd_toStartOf="@+id/tv_value_widecg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_label_abis" />

        <TextView
            android:id="@+id/tv_value_widecg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@{(@bool/is_widecg)?@string/text_supported:@string/text_not_supported}"
            android:textAlignment="viewEnd"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            android:visibility="@{Build.VERSION.SDK_INT >= 26?View.VISIBLE:View.GONE}"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_label_widecg"
            app:layout_constraintTop_toBottomOf="@+id/tv_value_abis"
            tools:text="True" />


        <TextView
            android:id="@+id/tv_label_hdr"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/text_hdr"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            android:visibility="@{Build.VERSION.SDK_INT >= 26?View.VISIBLE:View.GONE}"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toStartOf="@+id/tv_value_hdr"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_label_widecg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <TextView
            android:id="@+id/tv_value_hdr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@{(@bool/is_highdr)?@string/text_supported:@string/text_not_supported}"
            android:textAlignment="viewEnd"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            android:visibility="@{Build.VERSION.SDK_INT >= 26?View.VISIBLE:View.GONE}"
            app:layout_constrainedHeight="true"
            app:layout_constraintStart_toEndOf="@+id/tv_label_hdr"
            app:layout_constraintTop_toBottomOf="@+id/tv_value_widecg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="True" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>