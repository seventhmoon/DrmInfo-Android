<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <import type="android.content.res.Configuration" />

        <import type="android.os.Build" />

        <import type="java.util.Collection" />

        <import type="com.androidfung.drminfo.Util" />

        <variable
            name="infoProperties"
            type="androidx.databinding.ObservableMap&lt;String, Object&gt;" />

        <variable
            name="handler"
            type="com.androidfung.drminfo.ui.mobile.MyHandlers" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_label_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/listitem_padding"
            android:text="@string/text_brand"
            android:textAppearance="?attr/textAppearanceCaption" />

        <TextView
            android:id="@+id/tv_value_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{Build.BRAND}"
            android:textAppearance="?attr/textAppearanceBody2"
            tools:text="Google" />

        <TextView
            android:id="@+id/tv_label_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/listitem_padding"
            android:text="@string/text_model"
            android:textAppearance="?attr/textAppearanceCaption"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_value_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{Build.MODEL}"
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility="gone"
            tools:text="Pixel" />

        <TextView
            android:id="@+id/tv_label_product"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/listitem_padding"
            android:text="@string/text_hardware"
            android:textAppearance="?attr/textAppearanceCaption" />

        <TextView
            android:id="@+id/tv_value_product"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="@{Build.HARDWARE}"
            android:textAppearance="?attr/textAppearanceBody2"
            tools:text="sailfish" />

        <TextView
            android:id="@+id/tv_label_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/listitem_padding"
            android:text="@string/text_display"
            android:textAppearance="?attr/textAppearanceCaption" />

        <TextView
            android:id="@+id/tv_value_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{Build.DISPLAY}"
            android:textAppearance="?attr/textAppearanceBody2"
            android:onLongClick="@{handler::onLongClick}"
            tools:text="PPR1" />

        <TextView
            android:id="@+id/tv_label_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/listitem_padding"
            android:text="@string/text_type"
            android:textAppearance="?attr/textAppearanceCaption" />

        <TextView
            android:id="@+id/tv_value_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{Build.TYPE}"
            android:textAppearance="?attr/textAppearanceBody2"
            tools:text="user" />

        <TextView
            android:id="@+id/tv_label_fingerprint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/listitem_padding"
            android:text="@string/text_fingerprint"
            android:textAppearance="?attr/textAppearanceCaption" />

        <TextView
            android:id="@+id/tv_value_fingerprint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{Build.FINGERPRINT}"
            android:textAppearance="?attr/textAppearanceBody2"
            android:onLongClick="@{handler::onLongClick}"
            tools:text="google/sdk_gphone_x86_64/generic_x86_64_arm64:10/RSR1.200417.003/6415074:user/release-keys" />

        <TextView
            android:id="@+id/tv_label_sdklevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/listitem_padding"
            android:text="@string/text_sdk_level"
            android:textAppearance="?attr/textAppearanceCaption" />

        <TextView
            android:id="@+id/tv_value_sdklevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="@{String.valueOf(Build.VERSION.SDK_INT)}"
            android:textAppearance="?attr/textAppearanceBody2"
            tools:text="1" />

        <TextView
            android:id="@+id/tv_label_abis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/listitem_padding"
            android:text="@string/text_abi"
            android:textAppearance="?attr/textAppearanceCaption"
            android:visibility="@{Build.VERSION.SDK_INT >= 21?View.VISIBLE:View.GONE}" />

        <TextView
            android:id="@+id/tv_value_abis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text='@{(Build.VERSION.SDK_INT &lt; 21)?"-":Util.format(Build.SUPPORTED_ABIS)}'
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility="@{Build.VERSION.SDK_INT >= 21?View.VISIBLE:View.GONE}"
            android:onLongClick="@{handler::onLongClick}"
            tools:text="1" />

        <TextView
            android:id="@+id/tv_label_hw_decode_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/listitem_padding"
            android:text="@string/text_hw_decode_type"
            android:textAppearance="?attr/textAppearanceCaption"
            android:visibility='@{Util.goneIfNullOrEmpty(infoProperties["hardwareAcceleratedType"])}' />

        <TextView
            android:id="@+id/tv_value_hw_decode_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text='@{Util.format(infoProperties["hardwareAcceleratedType"])}'
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility='@{Util.goneIfNullOrEmpty(infoProperties["hardwareAcceleratedType"])}'
            android:onLongClick="@{handler::onLongClick}"
            tools:text="1" />

        <TextView
            android:id="@+id/tv_label_supported_hdr_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/listitem_padding"
            android:text="@string/text_supported_hdr_types"
            android:textAppearance="?attr/textAppearanceCaption"
            android:visibility='@{Util.goneIfNullOrEmpty(infoProperties["supportedHdrType"])}' />

        <TextView
            android:id="@+id/tv_value_supported_hdr_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text='@{Util.format(infoProperties["supportedHdrType"])}'
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility='@{Util.goneIfNullOrEmpty(infoProperties["supportedHdrType"])}'
            tools:text="@string/text_supported" />

        <TextView
            android:id="@+id/tv_label_supported_refresh_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/listitem_padding"
            android:text="@string/text_supported_refresh_rate"
            android:textAppearance="?attr/textAppearanceCaption"
            android:visibility='@{Util.goneIfNullOrEmpty(infoProperties["supportedRefreshRate"])}' />

        <TextView
            android:id="@+id/tv_value_supported_refresh_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text='@{Util.format(infoProperties["supportedRefreshRate"])}'
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility='@{Util.goneIfNullOrEmpty(infoProperties["supportedRefreshRate"])}'
            tools:text="@string/text_supported" />

    </LinearLayout>
</layout>