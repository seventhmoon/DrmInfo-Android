<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".MobileActivity">

    <data>

        <variable
            name="infoProperties"
            type="androidx.databinding.ObservableMap&lt;String, Object&gt;" />

        <variable
            name="clearkeyProperties"
            type="androidx.databinding.ObservableMap&lt;String, Object&gt;" />

        <variable
            name="widevineProperties"
            type="androidx.databinding.ObservableMap&lt;String, Object&gt;" />

        <variable
            name="playreadyProperties"
            type="androidx.databinding.ObservableMap&lt;String, Object&gt;" />

        <variable
            name="wiseplayProperties"
            type="androidx.databinding.ObservableMap&lt;String, Object&gt;" />

        <variable name="handler" type="com.androidfung.drminfo.ui.mobile.MyHandlers"/>

    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true"
            android:background="?attr/colorPrimaryContainer"
            app:liftOnScroll="true">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                />
        </com.google.android.material.appbar.AppBarLayout>

        <include
            layout="@layout/content_mobile"
            bind:handler="@{handler}"
            bind:infoProperties="@{infoProperties}"
            bind:clearkeyProperties="@{clearkeyProperties}"
            bind:playreadyProperties="@{playreadyProperties}"
            bind:widevineProperties="@{widevineProperties}"
            bind:wiseplayProperties="@{wiseplayProperties}"/>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>