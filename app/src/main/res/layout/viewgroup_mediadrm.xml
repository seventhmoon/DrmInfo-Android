<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <import type="android.text.TextUtils" />

        <import type="com.androidfung.drminfo.Util" />

        <variable
            name="properties"
            type="androidx.databinding.ObservableMap&lt;String, Object&gt;" />

        <variable
            name="handler"
            type="com.androidfung.drminfo.ui.mobile.MyHandlers" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/listitem_padding"
            android:singleLine="true"
            android:text="@string/mediadrm_string_property_name_vendor"
            android:textAppearance="?attr/textAppearanceCaption"
            android:visibility="@{Util.goneIfNullOrEmpty(properties[(@string/mediadrm_string_property_key_vendor)])}"
            app:layout_constraintEnd_toStartOf="@+id/textView4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Vendor" />

        <TextView
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text='@{properties[(@string/mediadrm_string_property_key_vendor)] ?? "-"}'
            android:textAlignment="viewEnd"
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility="@{Util.goneIfNullOrEmpty(properties[(@string/mediadrm_string_property_key_vendor)])}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/textView"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Google" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/listitem_padding"
            android:singleLine="true"
            android:text="@string/mediadrm_string_property_name_version"
            android:textAppearance="?attr/textAppearanceCaption"
            android:visibility="@{Util.goneIfNullOrEmpty(properties[(@string/mediadrm_string_property_key_version)])}"
            tools:text="Version" />

        <TextView
            android:id="@+id/textView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text='@{properties[(@string/mediadrm_string_property_key_version)] ?? "-"}'
            android:textAlignment="viewEnd"
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility="@{Util.goneIfNullOrEmpty(properties[(@string/mediadrm_string_property_key_version)])}"
            tools:text="1" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/listitem_padding"
            android:text="@string/mediadrm_string_property_name_algorithms"
            android:textAppearance="?attr/textAppearanceCaption"
            android:visibility="@{Util.goneIfNullOrEmpty(properties[(@string/mediadrm_string_property_key_algorithms)])}"
            tools:text="Algorithm" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onLongClick="@{handler::onLongClick}"
            android:text='@{properties[(@string/mediadrm_string_property_key_algorithms)] ?? "-"}'
            android:textAlignment="viewEnd"
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility="@{Util.goneIfNullOrEmpty(properties[(@string/mediadrm_string_property_key_algorithms)])}"
            tools:text="AES................" />

